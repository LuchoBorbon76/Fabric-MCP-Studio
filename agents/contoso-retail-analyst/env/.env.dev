# Committed defaults for the "dev" environment. scripts/install-teams-agent.ps1 fills the IDs.
# Secrets go in .env.dev.user (git-ignored) and are encrypted by the Agents Toolkit.
TEAMSFX_ENV=dev
APP_NAME_SUFFIX=

# Filled by provisioning
TEAMS_APP_ID=
FABRIC_IQ_AUTH_ID=
M365_TITLE_ID=
M365_APP_ID=

# Filled by install-teams-agent.ps1
AAD_TENANT_ID=
FABRIC_OAUTH_CLIENT_ID=

# Publisher info shown in the app details (change for your organization)
AGENT_PUBLISHER_NAME=Fabric MCP demo kit
AGENT_WEBSITE_URL=https://learn.microsoft.com/fabric/iq/overview
AGENT_PRIVACY_URL=https://privacy.microsoft.com/privacystatement
AGENT_TERMS_URL=https://learn.microsoft.com/fabric/iq/overview
AGENT_CONTACT_EMAIL=admin@example.com
