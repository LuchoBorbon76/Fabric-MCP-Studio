{
  "mcpServers": {
    "fabric-core": {
      "type": "http",
      "url": "https://api.fabric.microsoft.com/v1/mcp/core",
      "tools": ["*"]
    },
    "fabric-local": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "@microsoft/fabric-mcp@latest", "server", "start", "--mode", "all"],
      "tools": ["*"]
    },
    "powerbi-authoring": {
      "type": "http",
      "url": "https://api.fabric.microsoft.com/v1/mcp/powerbi/authoring",
      "tools": ["*"]
    },
    "fabric-iq": {
      "type": "http",
      "url": "https://fabriciq.svc.cloud.microsoft/v1/mcp/fabriciq",
      "tools": ["*"]
    }
  }
}
